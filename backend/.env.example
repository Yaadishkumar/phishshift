# PhishShift Backend Environment Configuration
# PORT: Provided automatically by Render (default: 5000)
PORT=5000

# HOST: Network host interface (0.0.0.0 for container/Render hosting)
HOST=0.0.0.0

# FLASK_DEBUG: Set to 1 for development, 0 for production
FLASK_DEBUG=0

# ALLOWED_ORIGINS: Comma-separated allowed frontend origins, or '*' for open access
# Example: ALLOWED_ORIGINS=https://phishshift.onrender.com
ALLOWED_ORIGINS=*

# SECRET_KEY: Secret key for session security in production
SECRET_KEY=change-this-to-a-secure-random-secret-in-production
