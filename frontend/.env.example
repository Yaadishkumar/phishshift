# PhishShift Frontend Environment Configuration
# In production on Render (or other hosts), set VITE_API_URL to your deployed backend URL.
# Example for Render Web Service:
# VITE_API_URL=https://phishshift-backend.onrender.com
#
# When left blank during local development, Vite proxies '/api' to http://127.0.0.1:5000.
VITE_API_URL=
